        {
          "name": "GET Sessions by Teachers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "const data = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response is an array\", function () {\r",
                  "    pm.expect(data).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "if (data.length > 0) {\r",
                  "    pm.test(\"Each session has correct structure\", function () {\r",
                  "        data.forEach((item) => {\r",
                  "            pm.expect(item).to.be.an(\"object\");\r",
                  "\r",
                  "            pm.expect(item).to.have.property(\"id\");\r",
                  "            pm.expect(item.id).to.be.a(\"number\");\r",
                  "\r",
                  "            pm.expect(item).to.have.property(\"date\");\r",
                  "            pm.expect(item.date).to.be.a(\"string\").and.not.empty;\r",
                  "\r",
                  "            pm.expect(item).to.have.property(\"start_time\");\r",
                  "            pm.expect(item.start_time).to.be.a(\"string\").and.not.empty;\r",
                  "\r",
                  "            pm.expect(item).to.have.property(\"end_time\");\r",
                  "            pm.expect(item.end_time).to.be.a(\"string\").and.not.empty;\r",
                  "\r",
                  "            pm.expect(item).to.have.property(\"user\");\r",
                  "            pm.expect(item.user).to.be.a(\"number\");\r",
                  "\r",
                  "            pm.expect(item).to.have.property(\"teacher_fullname\");\r",
                  "            pm.expect(item.teacher_fullname).to.be.a(\"string\");\r",
                  "\r",
                  "            pm.expect(item).to.have.property(\"room\");\r",
                  "            pm.expect(item.room).to.be.an(\"object\");\r",
                  "\r",
                  "            pm.expect(item.room).to.have.property(\"id\");\r",
                  "            pm.expect(item.room.id).to.be.a(\"number\");\r",
                  "\r",
                  "            pm.expect(item.room).to.have.property(\"name\");\r",
                  "            pm.expect(item.room.name).to.be.a(\"string\").and.not.empty;\r",
                  "\r",
                  "            pm.expect(item.room).to.have.property(\"capacity\");\r",
                  "            pm.expect(item.room.capacity).to.be.a(\"number\");\r",
                  "        });\r",
                  "    });\r",
                  "}"
                ],
