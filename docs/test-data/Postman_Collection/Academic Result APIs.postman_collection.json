    {
      "name": "List Score by ClassID",
      "item": [
        {
          "name": "GET List Score by admin - SUCCESS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Score list is not empty\", function () {\r",
                  "    let data = pm.response.json();\r",
                  "\r",
                  "    pm.expect(data.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Score fields are valid\", function () {\r",
                  "    let data = pm.response.json();\r",
                  "\r",
                  "    data.forEach(item => {\r",
                  "        pm.expect(item).to.have.property(\"id\");\r",
                  "        pm.expect(item).to.have.property(\"score_value\");\r",
                  "        pm.expect(item).to.have.property(\"score_type\");\r",
                  "        pm.expect(item).to.have.property(\"student\");\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Student fields are valid\", function () {\r",
                  "    let data = pm.response.json();\r",
                  "\r",
                  "    data.forEach(item => {\r",
                  "        pm.expect(item.student).to.have.property(\"id\");\r",
                  "        pm.expect(item.student).to.have.property(\"first_name\");\r",
                  "        pm.expect(item.student).to.have.property(\"last_name\");\r",
                  "        pm.expect(item.student).to.have.property(\"email\");\r",
                  "        pm.expect(item.student).to.have.property(\"username\");\r",
                  "        pm.expect(item.student).to.have.property(\"full_name\");\r",
                  "    });\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
