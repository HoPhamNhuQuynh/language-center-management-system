        {
          "name": "GET Enrollment by enroll_id - SUCCESS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"TC22 - Xem chi tiết enrollment thành công\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"TC22 - Có đủ field enrollment\", function () {\r",
                  "    let jsonData = pm.response.json();\r",
                  "\r",
                  "    pm.expect(jsonData).to.include.all.keys(\r",
                  "        \"id\",\r",
                  "        \"student\",\r",
                  "        \"classroom\",\r",
                  "        \"enrollment_status\",\r",
                  "        \"payment_deadline\",\r",
                  "        \"created_at\",\r",
                  "        \"updated_at\",\r",
                  "        \"active\"\r",
                  "    );\r",
                  "});\r",
                  "\r",
                  "pm.test(\"TC22 - student là object\", function () {\r",
                  "    let student = pm.response.json().student;\r",
                  "\r",
                  "    pm.expect(student).to.be.an(\"object\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"TC22 - classroom là object\", function () {\r",
                  "    let classroom = pm.response.json().classroom;\r",
                  "\r",
                  "    pm.expect(classroom).to.be.an(\"object\");\r",
                  "});\r",
                  "\r",
