        {
          "name": "GET List Payments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "const data = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response is an array\", function () {\r",
                  "    pm.expect(data).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Payment list is not empty\", function () {\r",
                  "    pm.expect(data.length).to.be.greaterThan(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Each payment has correct structure\", function () {\r",
                  "    data.forEach((item) => {\r",
                  "        pm.expect(item).to.be.an(\"object\");\r",
                  "\r",
                  "        pm.expect(item).to.have.property(\"id\");\r",
                  "        pm.expect(item.id).to.be.a(\"number\");\r",
                  "\r",
                  "        pm.expect(item).to.have.property(\"enrollment\");\r",
                  "        pm.expect(item.enrollment).to.be.a(\"number\");\r",
                  "\r",
                  "        pm.expect(item).to.have.property(\"amount\");\r",
                  "        pm.expect(item.amount).to.be.a(\"string\").and.not.empty;\r",
                  "\r",
                  "        pm.expect(item).to.have.property(\"payment_method\");\r",
                  "        pm.expect(item.payment_method).to.be.a(\"string\").and.not.empty;\r",
                  "\r",
                  "        pm.expect(item).to.have.property(\"paid_at\");\r",
                  "        pm.expect(item.paid_at).to.be.a(\"string\").and.not.empty;\r",
                  "\r",
                  "        pm.expect(item).to.have.property(\"classroom\");\r",
                  "        pm.expect(item.classroom).to.be.a(\"string\").and.not.empty;\r",
                  "    });\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
